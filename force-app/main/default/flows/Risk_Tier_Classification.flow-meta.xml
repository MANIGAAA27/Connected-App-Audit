<?xml version="1.0" encoding="UTF-8"?>
<!-- MODIFIED 2026-06-07 — Project: Connected App Audit 2.0 | LLD-ConnectedAppAudit20 | ASDA -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignments>
        <name>SetRiskTier</name>
        <label>Set Risk Tier</label>
        <locationX>440</locationX>
        <locationY>398</locationY>
        <assignmentItems>
            <assignToReference>$Record.Risk_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>calculatedRiskTier</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>UpdateRecord</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>CheckAlreadyCorrect</name>
        <label>Check Already Correct</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnector>
            <targetReference>EvaluateRiskScore</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Needs Update</defaultConnectorLabel>
        <rules>
            <name>AlreadyCorrect</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Risk_Tier__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>calculatedRiskTier</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>EndFlow</targetReference>
            </connector>
            <label>Already Correct</label>
        </rules>
    </decisions>
    <decisions>
        <name>EvaluateRiskScore</name>
        <label>Evaluate Risk Score</label>
        <locationX>352</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>SetRiskTier</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Tier</defaultConnectorLabel>
        <rules>
            <name>HighRisk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Risk_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>80.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetRiskTier</targetReference>
            </connector>
            <label>High Risk</label>
        </rules>
        <rules>
            <name>MediumRisk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Risk_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Risk_Score__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>80.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetRiskTier</targetReference>
            </connector>
            <label>Medium Risk</label>
        </rules>
        <rules>
            <name>LowRisk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Risk_Score__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetRiskTier</targetReference>
            </connector>
            <label>Low Risk</label>
        </rules>
    </decisions>
    <description>Automatically classifies Connected App risk tier based on risk score</description>
    <formulas>
        <name>calculatedRiskTier</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Risk_Score__c} &gt;= 80, &quot;High&quot;,
IF({!$Record.Risk_Score__c} &gt;= 50, &quot;Medium&quot;,
&quot;Low&quot;))</expression>
    </formulas>
    <interviewLabel>Risk Tier Classification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Risk Tier Classification</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>UpdateRecord</name>
        <label>Update Record</label>
        <locationX>440</locationX>
        <locationY>518</locationY>
        <connector>
            <targetReference>EndFlow</targetReference>
        </connector>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
    <screens>
        <name>EndFlow</name>
        <label>End Flow</label>
        <locationX>176</locationX>
        <locationY>638</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CheckAlreadyCorrect</targetReference>
        </connector>
        <object>Connected_App__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
