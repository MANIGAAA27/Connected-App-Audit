<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Submits Connected App Inventory record for risk-based approval and flags the status during review.</description>
    <label>CAI Approval Request Flow</label>
    <processType>AutolaunchedFlow</processType>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <isRequired>true</isRequired>
    </variables>
    <recordLookups>
        <name>Get_Connected_App_Record</name>
        <object>Connected_App_Inventory__c</object>
        <filters>
            <field>Id</field>
            <operator>equals</operator>
            <value>{!recordId}</value>
        </filters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <connector>
            <targetReference>Update_Status_In_Review</targetReference>
        </connector>
    </recordLookups>
    <recordUpdates>
        <name>Update_Status_In_Review</name>
        <object>Connected_App_Inventory__c</object>
        <recordId>{!Get_Connected_App_Record.Id}</recordId>
        <fieldValues>
            <field>Status__c</field>
            <value>
                <stringValue>In Review</stringValue>
            </value>
        </fieldValues>
    </recordUpdates>
    <start>
        <connector>
            <targetReference>Get_Connected_App_Record</targetReference>
        </connector>
    </start>
</Flow>