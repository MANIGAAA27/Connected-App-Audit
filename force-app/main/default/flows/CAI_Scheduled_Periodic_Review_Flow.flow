<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Schedules review tasks for Connected App Inventory records that are due.</description>
    <label>CAI Scheduled Periodic Review Flow</label>
    <processType>AutolaunchedFlow</processType>
    <status>Active</status>
    <triggerType>Schedule</triggerType>
    <start>
        <connector>
            <targetReference>Get_Apps_Due</targetReference>
        </connector>
    </start>
    <scheduledPaths>
        <name>DailyStart</name>
        <pathType>Start</pathType>
        <timeOffset>
            <type>Minutes</type>
            <value>0</value>
        </timeOffset>
        <connector>
            <targetReference>Get_Apps_Due</targetReference>
        </connector>
    </scheduledPaths>
    <recordLookups>
        <name>Get_Apps_Due</name>
        <object>Connected_App_Inventory__c</object>
        <filters>
            <field>Status__c</field>
            <operator>equals</operator>
            <value>Active</value>
        </filters>
        <filters>
            <field>Next_Review_Date__c</field>
            <operator>lessOrEqual</operator>
            <value>{!$Flow.CurrentDate}</value>
        </filters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <connector>
            <targetReference>Schedule_Review_Task</targetReference>
        </connector>
    </recordLookups>
    <recordCreates>
        <name>Schedule_Review_Task</name>
        <object>Task</object>
        <fieldValues>
            <field>Subject</field>
            <value>
                <stringValue>Periodic Review for {!Get_Apps_Due.App_Name__c}</stringValue>
            </value>
        </fieldValues>
        <fieldValues>
            <field>WhatId</field>
            <value>
                <stringValue>{!Get_Apps_Due.Id}</stringValue>
            </value>
        </fieldValues>
        <fieldValues>
            <field>OwnerId</field>
            <value>
                <stringValue>{!Get_Apps_Due.Business_Owner__c}</stringValue>
            </value>
        </fieldValues>
        <fieldValues>
            <field>ActivityDate</field>
            <value>
                <stringValue>{!$Flow.CurrentDate}</stringString>
            </value>
        </fieldValues>
    </recordCreates>
</Flow>