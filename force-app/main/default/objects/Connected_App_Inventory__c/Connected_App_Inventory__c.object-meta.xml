<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Connected App Inventory</label>
    <pluralLabel>Connected App Inventories</pluralLabel>
    <nameField>
        <type>Text</type>
        <label>Connected App Inventory Name</label>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>Private</sharingModel>
    <enableActivities>true</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableHistory>true</enableHistory>
    <allowInChatterGroups>true</allowInChatterGroups>
    <validationRules>
        <fullName>Enforce_Owner_Required_for_Active_Apps</fullName>
        <errorConditionFormula>AND(ISPICKVAL(Status__c, "Active"), OR(ISBLANK(Business_Owner__c), ISBLANK(Technical_Owner__c)))</errorConditionFormula>
        <errorDisplayField>Business_Owner__c</errorDisplayField>
        <errorMessage>An active app must have both a Business and Technical Owner assigned.</errorMessage>
        <active>true</active>
    </validationRules>
    <validationRules>
        <fullName>Obsolete_Reason_Required</fullName>
        <errorConditionFormula>AND(ISPICKVAL(Status__c, "Obsolete"), ISBLANK(TEXT(Decommission_Reason__c)))</errorConditionFormula>
        <errorDisplayField>Decommission_Reason__c</errorDisplayField>
        <errorMessage>A reason must be provided when marking an app as Obsolete.</errorMessage>
        <active>true</active>
    </validationRules>
</CustomObject>